# Copy to .env.deploy in the repository root (ignored by Git).
# Shell environment overrides this file. Existing .env and frontend/.env.local
# supply fallback values; no file is executed as a shell script.
PROJECT_ID=
REGION=us-central1
SERVICE_NAME=your-optimiser
# Required: public web configuration from your Firebase project settings.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Required: create a GitHub App first. Final callback/webhook URLs are printed.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
# Supply initial values here or create the named secrets in Secret Manager first.
# Existing secrets are reused, never overwritten by a redeployment.
# OPT_MANAGED_API_KEY= (or GOOGLE_API_KEY from your existing ignored .env)
# GITHUB_CLIENT_SECRET=
# GITHUB_PRIVATE_KEY_FILE=/absolute/path/to/github-app.pem
# GITHUB_WEBHOOK_SECRET= (generated if omitted for a new secret)
# OPT_SECRET_KEY= (generated if omitted for a new secret; retain it permanently)
# Optional resource-name overrides:
# APP_SECRET_RESOURCE=your-optimiser-app-key
# MODEL_SECRET_RESOURCE=your-optimiser-model-key
# GITHUB_KEY_RESOURCE=your-optimiser-github-pem
# GITHUB_OAUTH_RESOURCE=your-optimiser-github-oauth
# GITHUB_WEBHOOK_RESOURCE=your-optimiser-webhook
MANAGED_PROVIDER=google
MANAGED_MODEL=gemini-3.8-flash
# Optional preselected HTTPS domain already routed to this Cloud Run service.
# Otherwise the stable run.app URL is discovered/constructed before the build.
# SITE_URL=https://optimiser.example.com
MEMORY=2Gi
CPU=1
MAX_INSTANCES=1
# Regular reconciliation plus recovery if event-driven dispatch fails.
RECONCILE_SCHEDULE=0 * * * *
