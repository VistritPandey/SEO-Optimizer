# Complete hosted deployment template for ./deploy.sh.
# Copy this file to .env.deploy in the repository root (ignored by Git).
# Shell environment overrides this file. Existing .env and frontend/.env.local
# supply fallback values; no file is executed as a shell script.
PROJECT_ID=
REGION=us-central1
SERVICE_NAME=your-optimiser
# Required: public web configuration from your Firebase project settings.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Required: create a GitHub App first. Final callback/webhook URLs are printed.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
# Private credentials: required on first deployment unless their named Secret
# Manager resources already exist. Blank values allow existing .env fallbacks.
# Obtain the Gemini key from Google AI Studio; never use NEXT_PUBLIC_ for it.
GOOGLE_API_KEY=
# From your GitHub App settings (one service-owned App, customer installations).
GITHUB_CLIENT_SECRET=
# Path to the GitHub App's downloaded PEM, preferably outside this repository.
GITHUB_PRIVATE_KEY_FILE=
# Alternatively set OPT_MANAGED_API_KEY instead of GOOGLE_API_KEY.
# Existing Secret Manager values are reused, never overwritten by redeployment.
# Generated on first deployment when omitted:
# GITHUB_WEBHOOK_SECRET=
# OPT_SECRET_KEY=
# Optional resource-name overrides:
# APP_SECRET_RESOURCE=your-optimiser-app-key
# MODEL_SECRET_RESOURCE=your-optimiser-model-key
# GITHUB_KEY_RESOURCE=your-optimiser-github-pem
# GITHUB_OAUTH_RESOURCE=your-optimiser-github-oauth
# GITHUB_WEBHOOK_RESOURCE=your-optimiser-webhook
MANAGED_PROVIDER=google
MANAGED_MODEL=gemini-3.8-flash
# Optional preselected HTTPS domain already routed to this Cloud Run service.
# Otherwise the stable run.app URL is discovered/constructed before the build.
# SITE_URL=https://optimiser.example.com
MEMORY=2Gi
CPU=1
MAX_INSTANCES=1
# Regular reconciliation plus recovery if event-driven dispatch fails.
RECONCILE_SCHEDULE=0 * * * *
