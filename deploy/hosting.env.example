# Export these before running ./deploy/cloud-run.sh. Resource names contain no values.
PROJECT_ID=your-explicit-project-id
REGION=us-central1
FRONTEND_URL=https://your-frontend.example
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
APP_SECRET_RESOURCE=your-optimiser-app-key
MODEL_SECRET_RESOURCE=your-optimiser-model-key
GITHUB_KEY_RESOURCE=your-optimiser-github-pem
GITHUB_OAUTH_RESOURCE=your-optimiser-github-oauth
GITHUB_WEBHOOK_RESOURCE=your-optimiser-webhook
MANAGED_MODEL=gemini-3.8-flash

MANAGED_PROVIDER=google
