# Frontend development template: copy to frontend/.env.local.
# For the complete hosted app, use deploy/single-service.env.example instead:
# copy that file to .env.deploy in the repository root and run ./deploy.sh.
# Keep Gemini keys, GitHub secrets and private keys in the root deployment config.
# NEXT_PUBLIC_* values below are public Firebase/browser configuration.

# Server-only URL; no model keys, GitHub secrets or Firebase admin keys in frontend.
OPT_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Firebase web config is public configuration, not an admin credential.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Development only. Production builds explicitly reject this setting.
# NEXT_PUBLIC_AUTH_EMULATOR=http://127.0.0.1:9099
