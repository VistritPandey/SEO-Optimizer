# Server-only URL; no model keys, GitHub secrets or Firebase admin keys in frontend.
OPT_BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Firebase web config is public configuration, not an admin credential.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Development only. Production builds explicitly reject this setting.
# NEXT_PUBLIC_AUTH_EMULATOR=http://127.0.0.1:9099
