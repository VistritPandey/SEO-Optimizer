# Local development uses a protected generated secret and SQLite by default.
OPT_ENV=development
OPT_PUBLIC_URL=http://127.0.0.1:8000
OPT_DATA_DIR=.data
OPT_REGISTRATION=1
# OPT_REPO_ROOTS=/absolute/approved/repository/root
# Production web/worker settings (same key and database on both):
# OPT_ENV=production
# OPT_SECRET_KEY=generate-at-least-32-random-characters
# OPT_DATABASE_URL=postgresql+psycopg://user:password@host/database
# OPT_PUBLIC_URL=https://your-service.example
# OPT_REGISTRATION=0
# Local worker connected to a hosted control plane:
# OPT_CONTROL_URL=https://your-service.example
# OPT_WORKER_TOKEN=configure-the-scoped-token-from-workspace-settings
# Live benchmark credentials only; application keys are per-project and encrypted.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Managed SaaS (see docs/hosted-setup.md; actual keys come from Secret Manager):
# OPT_HOSTED=1
# OPT_STORAGE=firestore
# GOOGLE_CLOUD_PROJECT=
# OPT_FRONTEND_URL=https://your-frontend.example
# OPT_MANAGED_PROVIDER=google
# OPT_MANAGED_API_KEY=
# OPT_MANAGED_MODEL=gemini-3.8-flash
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
# OPT_BUILD_BACKEND=cloud-build
# OPT_BUILD_BUCKET=
# OPT_BUILD_ACCOUNT=
# OPT_BUILD_REGION=us-central1
# OPT_BUILD_MAX_PER_JOB=3
# OPT_FREE_PROJECTS=3
# OPT_FREE_JOBS=100
